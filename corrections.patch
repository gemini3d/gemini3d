index 00000000..d8acd712
--- /dev/null
+++ b/test/qualification/analyze_midpoint_diffusion.py
@@ -0,0 +1,147 @@
+"""Independent conservative balances and theoretical observables for native probes."""
+import argparse
+import csv
+import hashlib
+import json
+from pathlib import Path
+import numpy as np
+from scipy.integrate import solve_ivp
+from scipy.linalg import solve_banded
+
+p=argparse.ArgumentParser()
+p.add_argument('--work', type=Path, required=True)
+p.add_argument('--trace', type=Path)
+p.add_argument('--candidate',required=True)
+a=p.parse_args()
+w=a.work
+LIMIT=1e-11
+def rows(path):
+    with path.open() as f:
+        return [{k:float(v) for k,v in r.items()} for r in csv.DictReader(f)]
+def norm_res(terms):
+    return abs(sum(terms))/max(sum(abs(x) for x in terms), np.finfo(float).tiny)
+def orders(errors):
+    return [float(np.log2(errors[i]/errors[i+1])) for i in range(2)]
+
+conduct=[]
+traces={}
+if a.trace:
+    native_trace=np.loadtxt(a.trace,delimiter=',')
+    offset=0
+    for path in sorted(w.glob('conduction_*_m[23]_*.csv')):
+        rs=rows(path);nodes=int(max(r['node'] for r in rs));steps=int(max(r['step'] for r in rs))
+        count=steps*nodes
+        traces[path.name]=native_trace[offset:offset+count].reshape(steps,nodes,4)
+        offset+=count
+    assert offset==len(native_trace)
+oracle_cache={}
+for path in sorted(w.glob('conduction_*.csv')):
+    data=rows(path)
+    n=int(max(r['node'] for r in data));steps=int(max(r['step'] for r in data));r=data[0]
+    dt,dx,cv=r['dt'],r['dx'],r['Cv']
+    window=int(path.stem.split('_w')[1][0]);method=int(path.stem.split('_m')[1][0]);level=int(path.stem.split('_l')[1][0])
+    density=r['ns'];total=dt*steps
+    initial=np.linspace(600.,1500.,n)
+    scale=density/1e5
+    # Density scaling uses tau=t/scale so both cases independently share the
+    # same mathematically defined problem; retain each physical native result.
+    key=(n,window,total/scale)
+    if key not in oracle_cache:
+        def rhs(t, interior):
+            temp=np.r_[600.,interior,1500.]
+            lam=.3986e-12*temp**2.5
+            flux=-.5*(lam[:-1]+lam[1:])*np.diff(temp)/dx
+            return -(flux[1:]-flux[:-1])/(cv/scale*dx)
+        sol=solve_ivp(rhs,[0.,total/scale],initial[1:-1],method='Radau',rtol=1e-11,atol=1e-9)
+        tight=solve_ivp(rhs,[0.,total/scale],initial[1:-1],method='Radau',rtol=2e-13,atol=2e-11)
+        if not sol.success or not tight.success:
+            raise RuntimeError('Independent MOL oracle failed: '+sol.message+' / '+tight.message)
+        reference=np.r_[600.,tight.y[:,-1],1500.]
+        control=float(np.linalg.norm(sol.y[:,-1]-tight.y[:,-1])/np.linalg.norm(tight.y[:,-1]))
+        oracle_cache[key]={'temperature_K':reference,'control_relative_rms':control,
+                           'nfev':int(tight.nfev),'njev':int(tight.njev)}
+    oracle=oracle_cache[key]
+    step_balances=[];telescoping=[];diagnostic_balances=[];stage_mismatches=[];floors=0
+    for it in range(1,steps+1):
+        rs=[r for r in data if r['step']==it]
+        old=np.array([r['Told'] for r in rs]);new=np.array([r['Tnew'] for r in rs]);raw=np.array([r['Traw'] for r in rs])
+        lam=np.array([r['lambda_applied'] if 'lambda_applied' in r else r['lambda_old'] for r in rs]);face=.5*(lam[:-1]+lam[1:])
+        alpha=face/(cv*dx**2)
+        def flux(temp):return -face*np.diff(temp)/dx
+        if method==1:
+            integrated=dt*flux(raw)
+        else:
+            # Independent tridiagonal Crank-Nicolson half-stage for native
+            # TR-BDF2 (frozen lambda). No native residual is used as heat input.
+            c=dt/4
+            band=np.zeros((3,n-2));diagonal=alpha[:-1]+alpha[1:]
+            band[1]=1+c*diagonal
+            band[0,1:]=-c*alpha[1:-1];band[2,:-1]=-c*alpha[1:-1]
+            old_rhs=old[1:-1]+c*(alpha[1:]*np.diff(old)[1:]-alpha[:-1]*np.diff(old)[:-1])
+            old_rhs[0]+=c*alpha[0]*600;old_rhs[-1]+=c*alpha[-1]*1500
+            tr=np.r_[600.,solve_banded((1,1),band,old_rhs),1500.]
+            if path.name in traces:
+                native=traces[path.name][it-1]
+                assert np.array_equal(native[:,1],old) and np.array_equal(native[:,3],raw)
+                independent_tr=tr
+                tr=native[:,2]
+                stage_mismatches.append(float(np.max(abs(independent_tr-tr))/np.max(abs(tr))))
+            integrated=dt/3*(flux(old)+flux(tr)+flux(raw))
+            derived=(4*tr[1:-1]-old[1:-1])/3+dt/3*(alpha[1:]*np.diff(raw)[1:]-alpha[:-1]*np.diff(raw)[:-1])
+            stage_mismatches.append(float(np.max(abs(derived-raw[1:-1]))/np.max(abs(raw))))
+        change=float(cv*dx*np.sum(raw[1:-1]-old[1:-1]))
+        incoming=float(integrated[0]-integrated[-1])
+        power_cells=-(integrated[1:]-integrated[:-1])
+        scale_balance=max(float(np.sum(abs(cv*dx*(raw[1:-1]-old[1:-1])))),
+                          float(np.sum(abs(power_cells))),abs(integrated[0])+abs(integrated[-1]),np.finfo(float).tiny)
+        step_balances.append(abs(change-incoming)/scale_balance)
+        telescoping.append(abs(np.sum(power_cells)-incoming)/scale_balance)
+        inc=np.array([[r[k] for k in ('reaction','drift','conduction','source','reservoir')] for r in rs])
+        diagnostic_balances.append(float(np.max(abs(raw-old-np.sum(inc,axis=1)))/max(np.max(abs(raw-old)),np.finfo(float).tiny)))
+        floors+=int(np.count_nonzero(new!=raw))
+    final=np.array([r['Tnew'] for r in data if r['step']==steps])
+    error=float(np.linalg.norm(final[1:-1]-oracle['temperature_K'][1:-1])/np.linalg.norm(oracle['temperature_K'][1:-1]))
+    entry={'file':path.name,'density_m3':density,'window':window,'method':method,'level':level,
+           'steps':steps,'dt_s':dt,'duration_s':total,'temperature_relative_rms':error,
+           'oracle_control_relative_rms':oracle['control_relative_rms'],
+           'maximum_energy_balance_normalized':max(step_balances),
+           'maximum_face_telescoping_normalized':max(telescoping),
+           'maximum_diagnostic_increment_relative':max(diagnostic_balances),
+           'maximum_independent_TR_stage_relative':max(stage_mismatches,default=0),
+           'native_stage_trace_used':method==1 or path.name in traces,
+           'fixed_boundary_max_error_K':max(abs(r['Traw']-(600 if r['node']==1 else 1500)) for r in data if r['node'] in (1,n)),
+           'floor_cell_events':floors,'temperature_K':final.tolist(),
+           'oracle_temperature_K':oracle['temperature_K'].tolist(),
+           'energy_pass':max(step_balances)<=LIMIT,'temperature_pass':error<=.1}
+    conduct.append(entry)
+groups=[]
+for density,window,method in sorted(set((r['density_m3'],r['window'],r['method']) for r in conduct)):
+    levels=sorted([r for r in conduct if (r['density_m3'],r['window'],r['method'])==(density,window,method)],key=lambda r:r['level'])
+    os=orders([r['temperature_relative_rms'] for r in levels])
+    minorder=.9 if method==1 else 1.8
+    groups.append({'density_m3':density,'window':window,'method':method,'errors':[r['temperature_relative_rms'] for r in levels],
+                   'orders':os,'required_order':minorder,
+                   'energy_pass':all(r['energy_pass'] for r in levels),
+                   'temperature_pass':all(r['temperature_pass'] for r in levels),
+                   'order_pass':min(os)>=minorder})
+pc03={'cases':conduct,'groups':groups,'passed':all(r['energy_pass'] and r['temperature_pass'] and r['order_pass'] for r in groups)}
+
+kir=rows(w/'kirchhoff_flux.csv');steady=[]
+qexact=-.3986e-12*(1500.**3.5-600.**3.5)/(3.5*1e5)
+for level in range(3):
+    rs=[r for r in kir if r['level']==level]
+    temp=np.array([r['T'] for r in rs]);lam=np.array([r['lambda'] for r in rs]);dx=rs[0]['dx']
+    q=-.5*(lam[:-1]+lam[1:])*np.diff(temp)/dx
+    err=float(np.sqrt(np.mean((q-qexact)**2))/abs(qexact))
+    steady.append({'level':level,'nodes':len(rs),'dx_m':dx,'exact_flux_Wm2':qexact,
+                   'relative_l2_face_flux_error':err,'minimum_flux_Wm2':float(min(q)),'maximum_flux_Wm2':float(max(q))})
+pc04={'levels':steady,'orders':orders([r['relative_l2_face_flux_error'] for r in steady])}
+pc04['passed']=min(pc04['orders'])>=1.8
+result={'schema':'gemini.physical.closure.results.1','budget':LIMIT,
+        'native_source_revision':a.candidate,
+        'PC03':pc03,'PC04':pc04, 'passed':pc03['passed'] and pc04['passed']}
+(w/'physics-results.json').write_text(json.dumps(result,indent=2,allow_nan=False,default=lambda v:v.item() if isinstance(v,np.generic) else str(v))+'\n')
+print(json.dumps({k:{s:v for s,v in result[k].items() if s in ('passed','case_count','passing_cases','orders','groups')}
+                  for k in ('PC03','PC04')},indent=2))
+
+raise SystemExit(0 if result['passed'] else 1)
diff --git a/test/qualification/coulomb_curve.f90 b/test/qualification/coulomb_curve.f90
new file mode 100644
index 00000000..71a2aaa0
--- /dev/null
+++ b/test/qualification/coulomb_curve.f90
@@ -0,0 +1,37 @@
+program coulomb_curve
+use phys_consts,only:wp,lsp,kb,ms
+use collisions,only:coulomb_colln
+implicit none(type,external)
+real(wp),parameter::values(13)=[0._wp,1e-8_wp,1e-6_wp,.001_wp,.01_wp,.05_wp, &
+ .09999999_wp,.1_wp,.10000001_wp,.5_wp,1._wp,3._wp,10._wp]
+real(wp)::ns(-1:3,-1:3,-1:3,lsp),ts(-1:3,-1:3,-1:3,lsp),v(-1:3,-1:3,-1:3,lsp)
+real(wp)::nu(1,1,1),phi(1,1,1),psi(1,1,1),speed,w,oracle,error
+integer::i
+ns=0;ts=1000;v=0;ns(:,:,:,1)=2e11_wp;ns(:,:,:,6)=8e10_wp
+speed=sqrt(2*kb*1000/(ms(1)*ms(6)/(ms(1)+ms(6))))
+do i=1,size(values)
+ v(:,:,:,1)=values(i)*speed;w=abs(v(1,1,1,1))/speed
+ call coulomb_colln(1,6,ns,ts,v,nu,phi,psi)
+ ! Independent numerical integral on a fixed interval. This does not reuse
+ ! either production power-series coefficients or the erf expression.
+ oracle=integral(w);error=abs(phi(1,1,1)-oracle)
+ print '(2(es25.17,1x))',w,error
+ if(error>5e-14_wp)error stop 'Coulomb drag integral and continuity'
+enddo
+contains
+pure function integral(w)result(value)
+real(wp),intent(in)::w
+real(wp)::value,total,compensation,term,y,next,x,weight
+integer,parameter::n=4096
+integer::j
+total=exp(-w*w);compensation=0
+do j=1,n-1
+ x=real(j,wp)/n;weight=2
+ if(modulo(j,2)==1)weight=4
+ term=weight*x*x*exp(-(w*x)**2)
+ y=term-compensation;next=total+y
+ compensation=(next-total)-y;total=next
+enddo
+value=total/n
+end function
+end program
diff --git a/test/qualification/diffusion_scale.f90 b/test/qualification/diffusion_scale.f90
new file mode 100644
index 00000000..035ea757
--- /dev/null
+++ b/test/qualification/diffusion_scale.f90
@@ -0,0 +1,25 @@
+program diffusion_scale
+use phys_consts, only: wp
+use PDEparabolic, only: backEuler1D,TRBDF21D
+implicit none(type,external)
+integer,parameter::n=49
+real(wp)::u(n),initial(n),a(n),b(n),c(n),d(n),e(n),dx(0:n+2),dxi(n),dt,err,bcerr
+integer::i,method
+logical::passed
+a=0;b=0;c=1e18_wp;d=3e-5_wp;e=0
+dx=1e5_wp/(n-1);dxi=dx(1);dt=6.25e-5_wp
+initial=[(600+900._wp*(i-1)/(n-1),i=1,n)]
+passed=.true.
+do method=1,2
+ u=initial
+ if(method==1)then
+   u=backEuler1D(u,a,b,c,d,e,600._wp,1500._wp,dt,[0,0],dx,dxi)
+ else
+   u=TRBDF21D(u,a,b,c,d,e,600._wp,1500._wp,dt,[0,0],dx,dxi)
+ endif
+ err=maxval(abs(u-initial));bcerr=max(abs(u(1)-600),abs(u(n)-1500))
+ print '(i0,2(1x,es25.17))',method,err,bcerr
+ passed=passed.and.bcerr<=1e-11_wp
+enddo
+if(.not.passed)error stop 'prescribed boundary temperature lost under SI coefficient scaling'
+end program
diff --git a/test/qualification/midpoint_diffusion_probe.f90 b/test/qualification/midpoint_diffusion_probe.f90
new file mode 100644
index 00000000..84845548
--- /dev/null
+++ b/test/qualification/midpoint_diffusion_probe.f90
@@ -0,0 +1,130 @@
+program physics_native
+use phys_consts, only: wp,lsp,ln,kb,ms,gammas
+use collisions, only: coulomb_colln,thermal_conduct
+use sources, only: srcsEnergy
+use calculus, only: ETD_uncoupled
+use meshobj_cart, only: cartmesh
+use grid, only: set_total_grid_sizes,set_subgrid_sizes,set_gridflag
+use diffusion, only: diffusion_prep,backEuler3D,TRBDF23D
+use nonlinear_diffusion, only: midpoint_TRBDF23D
+use diffusion_features, only: midpoint_conduction_enabled
+use multifluid, only: energy_diffusion
+implicit none(type,external)
+character(4096) :: directory,trace_name
+integer :: trace_status
+call get_command_argument(1,directory)
+if(len_trim(directory)==0) error stop 'output directory required'
+call nonlinear_conduction()
+call kirchhoff_flux()
+call get_environment_variable('GEMINI_PHYSICAL_TR_TRACE',trace_name,status=trace_status)
+if(trace_status/=0) call wrapper_checks()
+contains
+
+subroutine nonlinear_conduction()
+integer,parameter :: n=49
+type(cartmesh) :: x
+real(wp) :: ns(-1:n+2,-1:3,-1:3),temp(-1:n+2,-1:3,-1:3),old(-1:n+2,-1:3,-1:3),raw(-1:n+2,-1:3,-1:3)
+real(wp) :: nn(n,1,1,ln),j1(-1:n+2,-1:3,-1:3),tn(n,1,1)
+real(wp) :: lam(n,1,1),beta(n,1,1),a(n,1,1),b(n,1,1),c(n,1,1),d(n,1,1),e(n,1,1),inc(n,1,1,5)
+real(wp) :: density,dx,total,dt,cv
+integer :: id,window,level,method,i,it,nt,u
+character(64) :: name
+call set_total_grid_sizes(n,1,1);call set_subgrid_sizes(1,1);call set_gridflag(2)
+x%lx1=n;x%lx2=1;x%lx3=1
+allocate(x%h1(-1:n+2,-1:3,-1:3),x%h2(-1:n+2,-1:3,-1:3),x%h3(-1:n+2,-1:3,-1:3))
+allocate(x%dx1(0:n+2),x%dx1i(n))
+x%h1=1;x%h2=1;x%h3=1;dx=1e5_wp/(n-1);x%dx1=dx;x%dx1i=dx
+nn=0;j1=0;tn=600
+do id=1,2
+  density=1e5_wp
+  if(id==2)density=1e11_wp
+  ns=density;cv=density*kb/(gammas(6)-1)
+  do window=3,3
+    if(window==2.and.id==2)cycle
+    total=.0001_wp*(density/1e5_wp)
+    if(window==2)total=.8_wp
+    do method=3,3
+      do level=0,2
+        nt=8*2**level;dt=total/nt
+        write(name,'(a,i0,a,i0,a,i0,a,i0,a)') 'conduction_d',id,'_w',window,'_m',method,'_l',level,'.csv'
+        open(newunit=u,file=trim(directory)//'/'//trim(name),status='new')
+        write(u,'(a)') 'step,node,t,dt,ns,dx,Cv,Told,Traw,Tnew,lambda_applied,reaction,drift,conduction,source,reservoir'
+        temp=600
+        do i=1,n
+          temp(i,1,1)=600+900._wp*(i-1)/(n-1)
+        enddo
+        do it=1,nt
+          old=temp
+          raw=midpoint_TRBDF23D(6,x,ns,temp,nn,j1,tn,1500._wp,dt,inc,lam)
+          temp=max(raw,100._wp)
+          do i=1,n
+            write(u,'(i0,",",i0,14(",",es25.17))') it,i,it*dt,dt,density,dx,cv,old(i,1,1), &
+              raw(i,1,1),temp(i,1,1),lam(i,1,1),inc(i,1,1,:)
+          enddo
+        enddo
+        close(u)
+      enddo
+    enddo
+  enddo
+enddo
+! The manually allocated probe mesh does not claim a complete application grid.
+deallocate(x%h1,x%h2,x%h3,x%dx1,x%dx1i)
+end subroutine
+
+subroutine kirchhoff_flux()
+integer :: level,n,i,u
+real(wp),allocatable :: temp(:,:,:),ns(:,:,:),nn(:,:,:,:),j1(:,:,:),lam(:,:,:),beta(:,:,:)
+real(wp) :: dx,xx
+open(newunit=u,file=trim(directory)//'/kirchhoff_flux.csv',status='new')
+write(u,'(a)') 'level,node,n,x,dx,T,lambda'
+do level=0,2
+  n=64*2**level+1;dx=1e5_wp/(n-1)
+  allocate(temp(-1:n+2,-1:3,-1:3),ns(-1:n+2,-1:3,-1:3),j1(-1:n+2,-1:3,-1:3))
+  allocate(nn(n,1,1,ln),lam(n,1,1),beta(n,1,1))
+  temp=600;ns=1e11_wp;j1=0;nn=0
+  do i=1,n
+    xx=real(i-1,wp)/real(n-1,wp)
+    temp(i,1,1)=(600._wp**3.5_wp+(1500._wp**3.5_wp-600._wp**3.5_wp)*xx)**(1/3.5_wp)
+  enddo
+  call thermal_conduct(6,temp,ns,nn,j1,lam,beta)
+  do i=1,n
+    write(u,'(i0,",",i0,",",i0,4(",",es25.17))') level,i,n,(i-1)*dx,dx,temp(i,1,1),lam(i,1,1)
+  enddo
+  deallocate(temp,ns,j1,nn,lam,beta)
+enddo
+close(u)
+end subroutine
+subroutine wrapper_checks()
+integer,parameter :: n=49
+type(cartmesh) :: x
+real(wp) :: ns(-1:n+2,-1:3,-1:3,lsp),temp(-1:n+2,-1:3,-1:3,lsp)
+real(wp) :: old(-1:n+2,-1:3,-1:3),raw(-1:n+2,-1:3,-1:3),plain(-1:n+2,-1:3,-1:3)
+real(wp) :: nn(n,1,1,ln),j(-1:n+2,-1:3,-1:3),tn(n,1,1),inc(n,1,1,5)
+integer :: i,flag
+call set_total_grid_sizes(n,1,1);call set_subgrid_sizes(1,1)
+x%lx1=n;x%lx2=1;x%lx3=1
+allocate(x%h1(-1:n+2,-1:3,-1:3),x%h2(-1:n+2,-1:3,-1:3),x%h3(-1:n+2,-1:3,-1:3))
+allocate(x%dx1(0:n+2),x%dx1i(n))
+x%h1=1;x%h2=1;x%h3=1;x%dx1=1e5_wp/(n-1);x%dx1i=x%dx1(1)
+ns=1e5_wp;nn=0;j=0;tn=600;temp=600
+call set_gridflag(2)
+do i=1,n
+ temp(i,1,1,:)=600+900._wp*(i-1)/(n-1)
+enddo
+old=temp(:,:,:,6)
+raw=midpoint_TRBDF23D(6,x,ns(:,:,:,6),old,nn,j,tn,1500._wp,1.25e-5_wp,inc)
+plain=midpoint_TRBDF23D(6,x,ns(:,:,:,6),old,nn,j,tn,1500._wp,1.25e-5_wp)
+if(any(raw/=plain))error stop 'optional midpoint diagnostics changed the state'
+if(midpoint_conduction_enabled) then
+ call energy_diffusion(1.25e-5_wp,x,ns,temp,j,nn,tn,2,1500._wp)
+ if(any(temp(:,:,:,6)/=max(raw,100._wp)))error stop 'standard production path differs from tested midpoint operator'
+endif
+! Inverted and standard zero-flux ion boundaries on constant temperature.
+do flag=1,2
+ call set_gridflag(flag);old=600
+ raw=midpoint_TRBDF23D(6,x,ns(:,:,:,6),old,nn,j,tn,-1e-6_wp,1.25e-5_wp,inc)
+ if(maxval(abs(raw(1:n,1,1)-600._wp))>1e-11_wp)error stop 'midpoint Neumann constant state changed'
+enddo
+deallocate(x%h1,x%h2,x%h3,x%dx1,x%dx1i)
+end subroutine wrapper_checks
+end program
diff --git a/test/qualification/pair_exchange_probe.f90 b/test/qualification/pair_exchange_probe.f90
new file mode 100644
index 00000000..b8af70c7
--- /dev/null
+++ b/test/qualification/pair_exchange_probe.f90
@@ -0,0 +1,80 @@
+program pair_exchange_probe
+use phys_consts, only: wp,lsp,kB,ms,gammas
+use collisions, only: coulomb_colln
+use pair_exchange, only: shared_pair_coefficients,pair_exchange_rates,advance_pair_exchange
+implicit none(type,external)
+real(wp) :: ns(-1:3,-1:3,-1:3,lsp),Ts(-1:3,-1:3,-1:3,lsp),v(-1:3,-1:3,-1:3,lsp)
+real(wp) :: nu(1,1,1),nurev(1,1,1),phi(1,1,1),psi(1,1,1),phirev(1,1,1),psirev(1,1,1)
+real(wp) :: rhoa,rhob,Ca,Cb,fraction,drag,K,dt,rate,Ua,Ub,va(3),vb(3),va0(3),vb0(3)
+real(wp) :: Fa(3),Fb(3),Qa,Qb,drag0,K0,energy_residual,momentum_residual,thermal_residual,fa0(3),fb0(3),q0a,q0b
+integer :: a,b,drift,level,u,it,nt
+character(4096) :: filename
+call get_command_argument(1,filename)
+if(len_trim(filename)==0) error stop 'pair probe requires CSV path'
+open(newunit=u,file=trim(filename),status='replace')
+write(u,'(a)') 'a,b,level,dt,rhoa,rhob,Ca,Cb,fraction_a,drag,K,Ta0,Tb0,'// &
+ 'va0x,va0y,va0z,vb0x,vb0y,vb0z,vax,vay,vaz,vbx,vby,vbz,Ta,Tb,'// &
+ 'instantaneous_momentum,instantaneous_energy,instantaneous_thermal'
+do a=1,lsp-1
+ do b=a+1,lsp
+  ns=0;Ts=900;v=0
+  ns(:,:,:,a)=2e11_wp;ns(:,:,:,b)=8e10_wp
+  Ts(:,:,:,a)=600;Ts(:,:,:,b)=1800
+  rhoa=2e11_wp*ms(a);rhob=8e10_wp*ms(b)
+  Ca=2e11_wp*kB/(gammas(a)-1);Cb=8e10_wp*kB/(gammas(b)-1)
+  fraction=ms(b)/(ms(a)+ms(b))
+  do drift=0,1
+   va0=real(drift,wp)*[1200._wp,300._wp,-600._wp]
+   vb0=real(drift,wp)*[-300._wp,-100._wp,200._wp]
+   v(:,:,:,a)=va0(1);v(:,:,:,b)=vb0(1)
+   call coulomb_colln(a,b,ns,Ts,v,nu,phi,psi)
+   call coulomb_colln(b,a,ns,Ts,v,nurev,phirev,psirev)
+   if(maxval(abs(phi-phirev))+maxval(abs(psi-psirev))>1e-13_wp) error stop 'pair response not symmetric'
+   call shared_pair_coefficients(ms(a),ms(b),2e11_wp,8e10_wp,nu(1,1,1),nurev(1,1,1), &
+     phi(1,1,1),psi(1,1,1),drag0,K0)
+   do level=0,8
+    drag=drag0;K=K0
+    if(level==6) K=2*drag*(1/rhoa+1/rhob)*Ca*(Cb/(Ca+Cb))
+    if(level==7) K=0
+    if(level==8) drag=0
+    rate=max(drag*(1/rhoa+1/rhob),K*(1/Ca+1/Cb))
+    select case(level)
+     case(0);dt=0
+     case(1);dt=1e-12_wp/rate
+     case(2);dt=.01_wp/rate
+     case(3);dt=.2_wp/rate
+     case(4);dt=2._wp/rate
+     case(5);dt=50._wp/rate
+     case default;dt=.3_wp/rate
+    end select
+    call pair_exchange_rates(ms(a),ms(b),drag,K,600._wp,1800._wp,va0,vb0,Fa,Fb,Qa,Qb)
+    call pair_exchange_rates(ms(a),ms(b),drag,K,600._wp,1800._wp,[0._wp,0._wp,0._wp], &
+      [0._wp,0._wp,0._wp],fa0,fb0,q0a,q0b)
+    momentum_residual=maxval(abs(Fa+Fb))/max(maxval(abs(Fa)),tiny(1._wp))
+    energy_residual=abs(Qa+Qb+sum(Fa*va0+Fb*vb0))/ &
+      max(abs(Qa)+abs(Qb)+sum(abs(Fa*va0)+abs(Fb*vb0)),tiny(1._wp))
+    thermal_residual=abs(q0a+q0b)/max(abs(q0a)+abs(q0b),tiny(1._wp))
+    va=va0;vb=vb0;Ua=Ca*600;Ub=Cb*1800
+    call advance_pair_exchange(rhoa,rhob,Ca,Cb,fraction,drag,K,dt,va,vb,Ua,Ub)
+    if(dt==0) then
+      if(any(va/=va0).or.any(vb/=vb0).or.Ua/=Ca*600.or.Ub/=Cb*1800) error stop 'zero-step pair changed state'
+    endif
+    write(u,'(3(i0,","),*(es25.17,:,","))') a,b,10*drift+level,dt,rhoa,rhob,Ca,Cb,fraction,drag,K, &
+      600._wp,1800._wp,va0,vb0,va,vb,Ua/Ca,Ub/Cb,momentum_residual,energy_residual,thermal_residual
+   enddo
+  enddo
+ enddo
+enddo
+! The original closed thermal-exchange fixture, now using one shared transfer.
+Ca=2e11_wp*kB/(5._wp/3-1);Cb=8e10_wp*kB/(5._wp/3-1);K=.2_wp*Ca
+do level=0,2
+ nt=5*2**level;dt=1._wp/nt
+ Ua=Ca*300;Ub=Cb*1800;va=0;vb=0
+ do it=1,nt
+  call advance_pair_exchange(1._wp,1._wp,Ca,Cb,.5_wp,0._wp,K,dt,va,vb,Ua,Ub)
+ enddo
+ write(u,'(3(i0,","),*(es25.17,:,","))') 0,0,level,1._wp,1._wp,1._wp,Ca,Cb,.5_wp,0._wp,K, &
+   300._wp,1800._wp,[0._wp,0._wp,0._wp],[0._wp,0._wp,0._wp],va,vb,Ua/Ca,Ub/Cb,0._wp,0._wp,0._wp
+enddo
+close(u)
+end program pair_exchange_probe
