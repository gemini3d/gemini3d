prefix="/home/runner/work/gemini3d/gemini3d/build/local"
exec_prefix="${prefix}"
libdir="/home/runner/work/gemini3d/gemini3d/build/local/lib"
includedir="/home/runner/work/gemini3d/gemini3d/build/local/include"

Name: h5fortran
Description: 3-D ionospheric model
URL: https://github.com/gemini3d/gemini
Version: 4.13.0
Requires: hdf5 >= 1.8.7
Cflags: -I"${includedir}"
Libs: -L"${libdir}" -lh5fortran
Libs.private: -L"${libdir}" -lh5fortran
