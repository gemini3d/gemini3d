# Prepare pinned source dependencies, including the nested MUMPS source.
# System compiler/MPI/HDF5/BLAS/LAPACK/ScaLAPACK packages and reference data are
# separate prerequisites. This script does not package a toolchain.
# Usage: cmake -Doffline_dir=/absolute/cache [-Darchive_dir=/archives]
#              -P scripts/offline_libraries.cmake
cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED offline_dir)
  set(offline_dir "${CMAKE_CURRENT_LIST_DIR}/../offline")
endif()
get_filename_component(offline_dir "${offline_dir}" ABSOLUTE)
if(NOT DEFINED archive_dir)
  set(archive_dir "${offline_dir}/archives")
endif()
file(MAKE_DIRECTORY "${offline_dir}" "${archive_dir}")
file(WRITE "${offline_dir}/.gitignore" "*\n")
file(READ "${CMAKE_CURRENT_LIST_DIR}/../cmake/libraries.json" json)
set(cache "# Generated by offline_libraries.cmake; machine-local source paths.\n")
foreach(lib IN ITEMS ffilesystem glow h5fortran hwm14 msis mumps mumps_upstream)
  string(JSON stem GET "${json}" "${lib}" "stem")
  string(JSON archive GET "${json}" "${lib}" "archive")
  string(JSON hash GET "${json}" "${lib}" "sha256")
  set(local_archive "${archive_dir}/${lib}.tar.gz")
  if(NOT EXISTS "${local_archive}")
    file(DOWNLOAD "${stem}${archive}" "${local_archive}" EXPECTED_HASH "SHA256=${hash}"
      TLS_VERIFY ON TIMEOUT 180 STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "${lib}: download failed: ${status}")
    endif()
  endif()
  file(SHA256 "${local_archive}" actual_hash)
  if(NOT actual_hash STREQUAL hash)
    message(FATAL_ERROR "${lib}: archive SHA256 mismatch; expected ${hash}, got ${actual_hash}")
  endif()
  set(extracted "${offline_dir}/${lib}-${hash}")
  if(NOT EXISTS "${extracted}/.complete")
    file(MAKE_DIRECTORY "${extracted}")
    file(ARCHIVE_EXTRACT INPUT "${local_archive}" DESTINATION "${extracted}")
    file(WRITE "${extracted}/.complete" "${hash}\n")
  endif()
  file(GLOB children LIST_DIRECTORIES true "${extracted}/*")
  set(roots)
  foreach(child IN LISTS children)
    if(IS_DIRECTORY "${child}")
      list(APPEND roots "${child}")
    endif()
  endforeach()
  list(LENGTH roots nroots)
  if(NOT nroots EQUAL 1)
    message(FATAL_ERROR "${lib}: expected one source root in verified archive")
  endif()
  list(GET roots 0 source)
  string(TOUPPER "${lib}" upper)
  string(APPEND cache "set(FETCHCONTENT_SOURCE_DIR_${upper} \"${source}\" CACHE PATH \"Verified offline source\" FORCE)\n")
  message(STATUS "${lib}: verified ${hash}")
endforeach()
string(APPEND cache "set(FETCHCONTENT_FULLY_DISCONNECTED ON CACHE BOOL \"Require prepared dependencies\" FORCE)\n")
file(WRITE "${offline_dir}/sources.cmake" "${cache}")
message(STATUS "Configure with -C ${offline_dir}/sources.cmake (system packages still required)")
